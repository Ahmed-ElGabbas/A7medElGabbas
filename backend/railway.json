{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run prisma:generate && npm run build"
  },
  "deploy": {
    "startCommand": "npm run start:prod",
    "preDeployCommand": "npm run prisma:deploy",
    "healthcheckPath": "/health"
  }
}