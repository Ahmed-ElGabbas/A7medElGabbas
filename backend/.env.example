# ---------------------------------------------------------------------------
# Copy this file to backend/.env and fill in real values locally.
# backend/.env is git-ignored (root .gitignore covers `.env*`) — never commit it.
# ---------------------------------------------------------------------------

# --- Database (Stage 0 required) -------------------------------------------
DATABASE_URL=""

# --- Auth (Stage 0 required) -----------------------------------------------
# Signing secrets for the access + refresh tokens. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""
# Access token lifetime (e.g. 1h). Refresh token lifetime (e.g. 7d).
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Admin seed credentials (LOCAL ONLY, seed time only) --------------------
# Read exclusively by prisma/seed.ts. Never deployed to Railway or Vercel.
# After the admin_users row exists (as a bcrypt hash) these have no further use.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Server ----------------------------------------------------------------
PORT=3001
NODE_ENV="development"
# Comma-separated list of allowed origins for CORS (the Next.js app origin).
CORS_ORIGIN="http://localhost:3000"
# Secret used to sign the refresh cookie. Defaults to JWT_REFRESH_SECRET if unset.
REFRESH_COOKIE_SECRET=""

# --- Media / Cloudflare R2 (Stage 1) ---------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public base URL that R2 objects are served from.
R2_PUBLIC_URL=""

# --- Notifications / Resend (Stage 2) ---------------------------------------
RESEND_API_KEY=""
ADMIN_NOTIFICATION_EMAIL=""
# Public base URL of the frontend, used to build the admin inbox deep link.
FRONTEND_URL="http://localhost:3000"

# --- Contact form (Stage 2) --------------------------------------------------
# Rate limit for POST /contact, per IP. Defaults to 3 submissions per 15 minutes.
# CONTACT_RATE_LIMIT="3"
# Accepts the same shorthand as the JWT lifetimes: 30s, 15m, 1h, 7d.
# CONTACT_RATE_WINDOW="15m"
# HMAC key used to hash the submitter's IP before it is stored. Falls back to
# JWT_SECRET when unset, so the column is never a readable IP address.
# CONTACT_IP_HASH_SALT=""
